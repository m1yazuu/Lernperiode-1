Console.WriteLine("Hello, World!");

Console.WriteLine("Passwort Generator");

Console.Write("Wie lang soll das Passwort sein? ");
int länge = Convert.ToInt32(Console.ReadLine());

Console.WriteLine("Deine gewünschte Passwortlänge ist: " + länge);

string zeichen = "abcdefghijklmnopqrstuvwxyz";
string passwort = "";

Random zufall = new Random();

for (int i = 0; i < länge; i++)
{
    int nummer = zufall.Next(zeichen.Length);
    passwort = passwort + zeichen[nummer];
}

Console.WriteLine("Dein Passwort ist: " + passwort);
